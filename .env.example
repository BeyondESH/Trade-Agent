# ---------------------------------------------------------------------------
# Repo-root .env — Docker Compose variable interpolation + Postgres credentials.
#
# Compose reads this file automatically (it sits next to compose.yaml). It is
# gitignored. Copy this example and pick a real password:
#     cp .env.example .env
# ---------------------------------------------------------------------------

# --- PostgreSQL (LangGraph checkpointer backend) ---
POSTGRES_USER=trade
# CHANGE ME: any non-empty password.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trade

# DSN the backend worker (and the migration script) uses to reach Postgres.
#   * In the compose stack the host MUST be the service name `postgres` (5432).
#   * From the host (psql / GUI client) use the published port: localhost:5433.
MD_POSTGRES_DSN=postgresql://trade:change-me@postgres:5432/trade
