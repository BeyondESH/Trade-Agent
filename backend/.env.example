# Bitget API credentials are OPTIONAL for public market data (klines).
# Only needed later for authenticated/trading changes.
# BITGET_API_KEY=
# BITGET_SECRET_KEY=
# BITGET_PASSPHRASE=

# BlockBeats news/data API key (https://www.theblockbeats.info/apiDoc).
# Required for /api/blockbeats/newsflash/* and /api/blockbeats/data/*.
# BB_API_KEY=

# --- market-data settings (all optional; defaults shown) ---
# Default ingestion targets used by the scheduled job.
MD_CATEGORY=USDT-FUTURES
MD_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
MD_TIMEFRAMES=1m,5m,15m,30m,1h,4h,12h,1d

# Market categories served by the exchange hub (Bitget product lines).
MD_CATEGORIES=SPOT,USDT-FUTURES

# Where Parquet data and Excel exports are written.
MD_DATA_DIR=./data

# Scheduled incremental pull period, in seconds.
MD_SCHEDULE_INTERVAL_SECONDS=300

# Scheduled Agent trading + DL retrain are opt-in (default off). The circuit
# breaker protective-close safety job always runs regardless of this flag.
MD_AGENT_SCHEDULE_ENABLED=false

# Command used to launch the Bitget MCP server (stdio).
MD_MCP_COMMAND=npx
MD_MCP_ARGS=-y,@bitget-ai/bitget-agent-mcp

# Per-request candle limit for the MCP candles tool (Bitget caps history at 100).
MD_CANDLE_PAGE_LIMIT=100

# Page size for the REST v2 deep-backfill path (the v2 endpoint caps at 1000).
MD_REST_CANDLE_PAGE_LIMIT=500

# Page size for the REST v3 deep-backfill path (v3 caps each request at 100 rows).
MD_V3_CANDLE_PAGE_LIMIT=100

# Pause between v2 REST backfill pages (seconds) to respect rate limits. 0 disables.
MD_BACKFILL_PAGE_DELAY=0.05

# Global news pipeline: background AKShare poll period (seconds) and ring-buffer size.
MD_NEWS_POLL_SECONDS=60
MD_NEWS_BUFFER_SIZE=500

# Bitget public WebSocket (real-time klines, no auth required).
MD_WS_PUBLIC_URL=wss://ws.bitget.com/v2/ws/public
MD_WS_HEARTBEAT_SECONDS=30
MD_WS_RECONNECT_SECONDS=5

# BlockBeats data cache: daily refresh time (default 12:00, local time).
MD_BLOCKBEATS_REFRESH_HOUR=12
MD_BLOCKBEATS_REFRESH_MINUTE=0

# Log level: DEBUG/INFO/WARNING/ERROR
MD_LOG_LEVEL=INFO
